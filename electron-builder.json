{
  "appId": "com.faazamu.projecttracker",
  "productName": "Project Tracker",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*"
  ],
  "linux": {
    "target": ["AppImage", "deb"],
    "category": "Office",
    "icon": "public/assets/icon-512.png"
  },
  "win": {
    "target": ["nsis", "portable"],
    "icon": "public/assets/icon-512.png"
  },
  "mac": {
    "target": ["dmg", "zip"],
    "category": "public.app-category.productivity",
    "icon": "public/assets/icon-512.png"
  }
}
